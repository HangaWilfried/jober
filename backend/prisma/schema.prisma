generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./jober.db"
}

// 1. Profil Utilisateur
model UserProfile {
  id                String   @id @default(cuid())
  fullName          String
  email             String
  phone             String
  headline          String
  location          String
  skills            String   // Stocké en JSON (liste de compétences)
  searchPreferences String   // Stocké en JSON (titres ciblés, remote, salaire min, etc.)
  resumes           Resume[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// 2. CVs de référence
model Resume {
  id            String       @id @default(cuid())
  profileId     String
  profile       UserProfile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name          String
  filePath      String?
  extractedText String?
  isPrimary     Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

// 3. Offres d'Emploi
model JobOffer {
  id          String        @id @default(cuid())
  title       String
  company     String
  location    String
  remoteType  String        @default("unknown") // full, hybrid, on-site, unknown
  url         String
  source      String        // Welcome to the Jungle, LinkedIn, Indeed, etc.
  description String
  publishedAt DateTime?
  expiresAt   DateTime?
  status      String        @default("new")     // new, analyzed, shortlisted, rejected, archived
  analysis    JobAnalysis?
  application Application?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

// 4. Analyse et Matching IA
model JobAnalysis {
  id                 String   @id @default(cuid())
  jobId              String   @unique
  job                JobOffer @relation(fields: [jobId], references: [id], onDelete: Cascade)
  matchScore         Int      // 0 - 100
  summary            String
  requiredSkills     String   // Stocké en JSON
  matchingSkills     String   // Stocké en JSON
  missingSkills      String   // Stocké en JSON
  minExperienceYears Int      @default(0)
  analysisMethod     String   @default("gemini")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// 5. Candidature
model Application {
  id                   String               @id @default(cuid())
  jobId                String               @unique
  job                  JobOffer             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status               String               @default("draft") // draft, prepared, ready_for_review, ready_to_submit, submitted_auto, submitted_manual, rejected
  matchScore           Int                  @default(0)
  readinessScore       Int                  @default(0)
  selectedResumeId     String?
  coverLetter          String               @default("")
  coverLetterConfirmed Boolean              @default(false)
  customizedResumeContent String            @default("")
  customizedResumeConfirmed Boolean         @default(false)
  customizedResumePath String?
  preparedAnswers      String               @default("[]") // Stocké en JSON
  customizedHighlights String               @default("[]") // Stocké en JSON
  blockers             ApplicationBlocker[]
  submittedAt          DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
}

// 6. Bloqueurs Human-in-the-Loop
model ApplicationBlocker {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type          String      // subjective_question, missing_document, captcha, salary_expectation, other
  question      String
  resolved      Boolean     @default(false)
  userResponse  String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}
